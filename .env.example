# The publishable key is designed to ship in the browser; RLS is what keeps it
# read-only. It still lives here rather than in the source, because a key in a
# repository is a key nobody can rotate without a commit.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Collector only — never exposed to the browser. Set in Supabase, not here.
# SERVICE_ROLE_KEY=
# GATEWAY_9ARM_KEY=
